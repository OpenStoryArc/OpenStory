# Rust — any cargo build dir at any depth (rs/target/ for the main workspace,
# rs/mcp/target/ for the incubating mcp sub-workspace, etc.)
**/target/

# Node
node_modules/
ui/dist/

# Data
data/
data-mongo/
data.old/
rs/data/

# Screenshots
screenshots/

# Local-only content (mirrors public paths, never committed)
personal/
captures/

# Claude local settings (ignore everything except project-level skills)
.claude/*
!.claude/skills/

# IDE
.vscode/
.idea/
.copilot/

# TypeScript build cache
*.tsbuildinfo

# OS artifacts
.DS_Store
nul
*.swp
*.heapsnapshot

# Coverage
coverage/
rs/target/llvm-cov-target/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Secrets (NEVER commit these)
.anthropic_api_key
.open_story_token
*.secret

# Generated history
history/
.env
.env.federation
deploy/*.env
!deploy/*.env.example

# Local-only deployment overrides (machine-specific tokens, hostnames, etc.).
# These pair with committed templates of the same name minus the `.local`.
docker-compose.*.local.yml
deploy/*.local.conf

# Local security audit reports
.gstack/

# Local-only content (never pushed)
personal/
captures/
.bandit-rt.json
.bandit-report.json
.semgrep-report.json
/tmp/gitleaks-rt.json
