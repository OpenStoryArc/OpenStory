# Rust
rs/target/

# Node
node_modules/
ui/dist/

# Data — session JSONL backups, SQLite shape databases, etc.
# Anything that contains captured user/assistant content stays out of git.
data/
data-mongo/
data.old/
rs/data/

# Captured probe output / session-derived facts / transcripts.
# These contain verbatim user prose, paths from people's machines, etc.
captures/
*.transcript.jsonl
*-session.jsonl
*.cloudevents.jsonl

# Personal — local-only home for content that mirrors public paths but stays
# off the network. Use this for: originals of anonymized docs, draft notes,
# scratch analyses, anything you want to keep on disk but not share. Pattern:
# personal/<mirror of public path>, e.g. personal/research/foo.md → docs/research/foo.md
personal/

# Screenshots
screenshots/

# Claude local settings (ignore everything except project-level skills)
.claude/*
!.claude/skills/

# IDE
.vscode/
.idea/
.copilot/

# TypeScript build cache
*.tsbuildinfo

# OS artifacts
.DS_Store
nul
*.swp
*.heapsnapshot

# Coverage
coverage/
rs/target/llvm-cov-target/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Secrets (NEVER commit these)
.anthropic_api_key
.open_story_token
*.secret

# Generated history
history/
.env
deploy/*.env
!deploy/*.env.example

# Local-only deployment overrides (machine-specific tokens, hostnames, etc.).
# These pair with committed templates of the same name minus the `.local`.
docker-compose.*.local.yml
deploy/*.local.conf

# Local security audit reports
.gstack/
