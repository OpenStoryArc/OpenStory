## OpenStory NATS account config — generated by `open_story_bus::accounts`.
##
## This file is illustrative: it shows the shape the generator produces. The
## live config used by deployed leaves and hubs is built at runtime from
## persisted `Person` records + `share_policy` rows, written to disk by
## `open_story_server::account_config::AccountConfigWriter`, and reloaded
## by signalling nats-server (SIGHUP locally, control subject in prod).
##
## DO NOT hand-edit this template expecting it to ship — point the
## generator at it instead.
##
## ─── Anatomy ──────────────────────────────────────────────────────────
##
## - One `account` per person in the directory (PR #54: `Person.id`).
## - One `user` per principal in their fleet (Phase 6 will swap password
##   for NKEY; same shape).
## - `exports` and `imports` are how cross-person sharing is consented:
##   the source account declares "Account B is allowed to consume subject
##   S," and the destination account declares the matching `import`. Either
##   alone delivers nothing.

listen: 0.0.0.0:4222
jetstream {
  store_dir: /var/lib/nats/jetstream
}

accounts {
  PERSON_MAX: {
    users: [
      { user: "max", password: "max-secret" }
    ]
    exports: [
      ## Max has shared session-X with Katie. Until the operator clicks
      ## "share with Katie" in the UI, this list is empty.
      { stream: "events.session-X.>", accounts: [PERSON_KATIE] }
    ]
  }
  PERSON_KATIE: {
    users: [
      { user: "katie", password: "katie-secret" }
    ]
    imports: [
      ## Katie's consent to receive Max's session-X. Mirrors the export
      ## above. Without this entry the export delivers nothing on her side.
      { stream: { account: PERSON_MAX, subject: "events.session-X.>" } }
    ]
  }
}
