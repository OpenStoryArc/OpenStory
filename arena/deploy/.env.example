# Copy to .env and fill in real values. .env is gitignored (repo-wide bare
# `.env` rule in the top-level .gitignore) — never commit it.
#
# IMPORTANT: keep every line below in the exact form `KEY=value`, with NO
# trailing comment on the same line. docker compose's .env parser treats
# everything after `=` — including a `# comment` — as the literal value.
# `LITELLM_MASTER_KEY=   # openssl rand -hex 32` would boot a WORKING stack
# whose master key is the literal string "  # openssl rand -hex 32", not
# an empty/unset value — a real, guessable secret hiding in a comment.

ARENA_BASE_DOMAIN=arena.openstory.work

# arena keygen (or: docker compose run --rm arena arena keygen)
ARENA_COOKIE_KEY=

# Cloudflare DNS-edit token for openstory.work, scoped to that zone only
CF_API_TOKEN=

# the ONE real key; never enters a sandbox
ANTHROPIC_API_KEY=

# openssl rand -hex 32
LITELLM_MASTER_KEY=

# openssl rand -hex 16
POSTGRES_PASSWORD=

# runsc for a real event; leave empty for local dev without gVisor
ARENA_DOCKER_RUNTIME=runsc

# Optional per-sandbox resource caps. Leave unset/empty to use the
# binary's own defaults (2 CPUs, 2GiB memory — see DEFAULT_SANDBOX_CPUS /
# DEFAULT_SANDBOX_MEMORY_BYTES in arena/src/cli.rs). Uncomment to override.
#ARENA_SANDBOX_CPUS=2
#ARENA_SANDBOX_MEMORY_BYTES=2147483648
