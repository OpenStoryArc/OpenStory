# Copy to .env and fill in real values. .env is gitignored (repo-wide bare
# `.env` rule in the top-level .gitignore) — never commit it.
ARENA_BASE_DOMAIN=arena.openstory.work
ARENA_COOKIE_KEY=            # arena keygen
CF_API_TOKEN=                # Cloudflare DNS-edit token for openstory.work
ANTHROPIC_API_KEY=           # the ONE real key; never enters a sandbox
LITELLM_MASTER_KEY=          # openssl rand -hex 32
POSTGRES_PASSWORD=           # openssl rand -hex 16
ARENA_DOCKER_RUNTIME=runsc   # unset for local dev without gVisor
